# Multi-AI Team Setup - Environment Configuration
# Copy this file to .env and configure your API keys.

# ==============================================================================
# Cloud API Keys
# ==============================================================================
# Anthropic API Key (Required for Claude Opus 5.5 / Sonnet 5.5 adversarial code reviews)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# DeepSeek API Key (Required for DeepSeek V4.1 Flash & DeepSeek V4 Pro logic/architecture)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Google Gemini API Key (Required for Gemini 4 Argon, Gemini 3.8 Flash, and Multimodal Vision)
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative alias for Google API Key
GOOGLE_API_KEY=

# OpenAI API Key (Required for GPT-6.1 Sol / GPT-4o abstract reasoning & audits)
OPENAI_API_KEY=your_openai_api_key_here

# ==============================================================================
# Local GPU & Ollama Configuration
# ==============================================================================
# Ollama base URL for local inference (RTX 4070 SUPER / local-autocomplete-fast / local-reasoner)
OLLAMA_API_BASE=http://127.0.0.1:11434

# ==============================================================================
# Fast Computer Use Daemon & Rate Options
# ==============================================================================
# Fast CU Daemon port (default: 18500)
FAST_CU_PORT=18500

# USD to JPY conversion rate for audit cost estimates
USD_JPY_RATE=155.0
